{
  "version": "1.0.0",
  "platform": "VibeChat",
  "brand": "Nexa-Group",
  "templates": [
    {
      "slug": "welcome",
      "name": "Welcome to VibeChat",
      "category": "transactional",
      "is_system": true,
      "preview_text": "Your vibe starts here. Welcome to VibeChat! 🎉",
      "subject": "Welcome to VibeChat, {{display_name}}! 🎉",
      "variables": ["display_name", "username", "verification_link", "app_download_link"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Welcome to VibeChat</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.tagline{color:#64748B;font-size:14px;margin-top:4px}.hero{background:linear-gradient(135deg,#8B5CF6 0%,#EC4899 100%);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0}.hero h1{color:#fff;font-size:28px;font-weight:800;margin:0 0 12px}.hero p{color:rgba(255,255,255,0.85);font-size:16px;margin:0 0 28px;line-height:1.6}.btn{display:inline-block;background:#fff;color:#8B5CF6;text-decoration:none;padding:14px 32px;border-radius:50px;font-weight:700;font-size:16px}.card{background:#12121A;border:1px solid rgba(255,255,255,0.08);border-radius:16px;padding:24px;margin:12px 0}.card-title{color:#F8FAFC;font-size:16px;font-weight:700;margin:0 0 8px}.card-text{color:#94A3B8;font-size:14px;line-height:1.6;margin:0}.feature-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:20px 0}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}.footer a{color:#8B5CF6;text-decoration:none}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div><div class='tagline'>by Nexa-Group</div></div><div class='hero'><h1>Welcome, {{display_name}}! 🎉</h1><p>Your account has been created. You're now part of the VibeChat community — where every moment becomes a vibe.</p><a href='{{verification_link}}' class='btn'>Verify Email & Start Vibing</a></div><div class='feature-grid'><div class='card'><div class='card-title'>💬 Real-Time Chat</div><div class='card-text'>Message friends instantly with end-to-end encrypted chats.</div></div><div class='card'><div class='card-title'>📸 Stories</div><div class='card-text'>Share 24-hour ephemeral moments with your circle.</div></div><div class='card'><div class='card-title'>🔥 Streaks</div><div class='card-text'>Keep your daily streak alive and climb the leaderboard.</div></div><div class='card'><div class='card-title'>⭐ Creators</div><div class='card-text'>Discover and follow amazing content creators.</div></div></div><div class='card'><div class='card-title'>Your Username</div><div class='card-text'>@{{username}}</div></div><div class='footer'><p>Download the app on <a href='{{app_download_link}}'>iOS & Android</a></p><p style='margin-top:8px'>© 2026 Nexa-Group. All rights reserved.<br><a href='#'>Unsubscribe</a> · <a href='#'>Privacy Policy</a></p></div></div></body></html>",
      "text_body": "Welcome to VibeChat, {{display_name}}!\n\nYour account has been created successfully.\nUsername: @{{username}}\n\nVerify your email here: {{verification_link}}\n\nDownload the app: {{app_download_link}}\n\n© 2026 Nexa-Group"
    },
    {
      "slug": "email-verification",
      "name": "Email Verification",
      "category": "transactional",
      "is_system": true,
      "preview_text": "Confirm your email address to activate your VibeChat account.",
      "subject": "Verify your VibeChat email address",
      "variables": ["display_name", "verification_code", "verification_link", "expiry_minutes"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Verify Email</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.box{background:#12121A;border:1px solid rgba(139,92,246,0.3);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0}.icon{width:64px;height:64px;background:linear-gradient(135deg,#8B5CF6,#EC4899);border-radius:50%;margin:0 auto 20px;display:flex;align-items:center;justify-content:center;font-size:28px;line-height:64px}.title{color:#F8FAFC;font-size:24px;font-weight:800;margin:0 0 12px}.subtitle{color:#94A3B8;font-size:15px;line-height:1.6;margin:0 0 32px}.code-box{background:#1A1A24;border:2px solid rgba(139,92,246,0.4);border-radius:12px;padding:24px;margin:0 0 24px}.code{font-size:40px;font-weight:800;letter-spacing:8px;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.code-label{color:#64748B;font-size:12px;margin-top:8px}.btn{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:14px 32px;border-radius:50px;font-weight:700;font-size:16px}.expiry{color:#64748B;font-size:13px;margin-top:20px}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='box'><div class='icon'>✉️</div><div class='title'>Verify Your Email</div><div class='subtitle'>Hey {{display_name}}, enter this code in the app or click the button below to verify your email address.</div><div class='code-box'><div class='code'>{{verification_code}}</div><div class='code-label'>VERIFICATION CODE</div></div><a href='{{verification_link}}' class='btn'>Verify Email Address</a><div class='expiry'>⏱ This code expires in {{expiry_minutes}} minutes.</div></div><div class='footer'><p>If you didn't create a VibeChat account, please ignore this email.</p><p>© 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hey {{display_name}},\n\nYour email verification code is: {{verification_code}}\n\nOr click here: {{verification_link}}\n\nThis code expires in {{expiry_minutes}} minutes.\n\nIf you didn't create this account, ignore this email.\n\n© 2026 Nexa-Group"
    },
    {
      "slug": "password-reset",
      "name": "Password Reset",
      "category": "transactional",
      "is_system": true,
      "preview_text": "Reset your VibeChat password — link expires in 60 minutes.",
      "subject": "Reset your VibeChat password",
      "variables": ["display_name", "reset_link", "expiry_minutes", "ip_address"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Reset Password</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.box{background:#12121A;border:1px solid rgba(239,68,68,0.3);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0}.icon{font-size:48px;margin-bottom:16px}.title{color:#F8FAFC;font-size:24px;font-weight:800;margin:0 0 12px}.subtitle{color:#94A3B8;font-size:15px;line-height:1.6;margin:0 0 32px}.btn{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:14px 36px;border-radius:50px;font-weight:700;font-size:16px}.warning{background:rgba(239,68,68,0.1);border:1px solid rgba(239,68,68,0.3);border-radius:12px;padding:16px;margin-top:24px;color:#EF4444;font-size:13px;text-align:left}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='box'><div class='icon'>🔐</div><div class='title'>Reset Your Password</div><div class='subtitle'>Hi {{display_name}}, we received a request to reset your VibeChat password. Click the button below to set a new password.</div><a href='{{reset_link}}' class='btn'>Reset Password</a><div class='warning'>⚠️ This link expires in {{expiry_minutes}} minutes.<br>If you didn't request this, your account may be at risk. Secure it immediately.<br><br>Request from IP: {{ip_address}}</div></div><div class='footer'><p>If you didn't request a password reset, please ignore this email and your password will remain unchanged.</p><p>© 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hi {{display_name}},\n\nReset your VibeChat password here: {{reset_link}}\n\nThis link expires in {{expiry_minutes}} minutes.\nRequest from IP: {{ip_address}}\n\nIf you didn't request this, please ignore this email.\n\n© 2026 Nexa-Group"
    },
    {
      "slug": "new-friend-request",
      "name": "New Friend Request",
      "category": "notification",
      "is_system": false,
      "preview_text": "Someone wants to connect with you on VibeChat!",
      "subject": "{{sender_name}} sent you a friend request on VibeChat 👋",
      "variables": ["recipient_name", "sender_name", "sender_username", "sender_avatar", "personal_message", "accept_link"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>Friend Request</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.card{background:#12121A;border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0}.avatar{width:80px;height:80px;border-radius:50%;margin:0 auto 16px;background:linear-gradient(135deg,#8B5CF6,#EC4899);display:block;object-fit:cover}.name{color:#F8FAFC;font-size:22px;font-weight:800;margin:0 0 4px}.username{color:#8B5CF6;font-size:14px;margin:0 0 20px}.message-box{background:#1A1A24;border-left:3px solid #8B5CF6;border-radius:8px;padding:16px;text-align:left;margin:20px 0;color:#94A3B8;font-size:14px;font-style:italic;line-height:1.6}.btn-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.btn-accept{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:12px 28px;border-radius:50px;font-weight:700;font-size:15px}.btn-view{display:inline-block;background:transparent;border:1px solid rgba(255,255,255,0.2);color:#94A3B8;text-decoration:none;padding:12px 28px;border-radius:50px;font-weight:600;font-size:15px}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}.footer a{color:#8B5CF6;text-decoration:none}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='card'><img src='{{sender_avatar}}' class='avatar' alt='{{sender_name}}'><div class='name'>{{sender_name}}</div><div class='username'>@{{sender_username}}</div><p style='color:#94A3B8;font-size:15px;margin:0 0 16px'>wants to be your friend on VibeChat!</p><div class='message-box'>💬 \"{{personal_message}}\"</div><div class='btn-row'><a href='{{accept_link}}' class='btn-accept'>Accept Request</a><a href='{{accept_link}}' class='btn-view'>View Profile</a></div></div><div class='footer'><p>You can manage friend requests in the VibeChat app.</p><p><a href='#'>Unsubscribe from notifications</a> · © 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hi {{recipient_name}},\n\n{{sender_name}} (@{{sender_username}}) wants to be your friend on VibeChat!\n\nMessage: \"{{personal_message}}\"\n\nAccept the request: {{accept_link}}\n\n© 2026 Nexa-Group"
    },
    {
      "slug": "vibechat-plus-promo",
      "name": "VibeChat+ Promotion",
      "category": "marketing",
      "is_system": false,
      "preview_text": "Unlock premium features — 30% off VibeChat+ this week only!",
      "subject": "⭐ Unlock VibeChat+ — 30% off this week only!",
      "variables": ["display_name", "discount_percent", "discount_code", "offer_expiry", "upgrade_link"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>VibeChat+ Offer</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.hero{background:linear-gradient(135deg,#0D0D1A,#1A0D2E);border:1px solid rgba(139,92,246,0.4);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0;position:relative;overflow:hidden}.badge{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;padding:6px 20px;border-radius:50px;font-size:12px;font-weight:800;text-transform:uppercase;letter-spacing:1px;margin-bottom:16px}.discount{font-size:72px;font-weight:900;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;line-height:1;margin:0}.discount-label{color:#94A3B8;font-size:14px;margin:8px 0 24px}.code-box{background:rgba(255,255,255,0.05);border:2px dashed rgba(139,92,246,0.5);border-radius:12px;padding:16px 24px;display:inline-block;margin-bottom:24px}.code-label{color:#64748B;font-size:11px;text-transform:uppercase;letter-spacing:1px}.code-value{color:#F8FAFC;font-size:24px;font-weight:800;letter-spacing:4px}.btn{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:16px 40px;border-radius:50px;font-weight:800;font-size:17px;box-shadow:0 8px 32px rgba(139,92,246,0.4)}.expiry{color:#64748B;font-size:12px;margin-top:16px}.features{margin:20px 0}.feature-row{display:flex;align-items:center;padding:12px 16px;background:#12121A;border-radius:10px;margin-bottom:8px;color:#94A3B8;font-size:14px}.feature-icon{margin-right:12px;font-size:18px}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}.footer a{color:#8B5CF6;text-decoration:none}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='hero'><div class='badge'>Limited Time Offer</div><div class='discount'>{{discount_percent}}%</div><div class='discount-label'>OFF VibeChat+ — just for you, {{display_name}}</div><div class='code-box'><div class='code-label'>Use code at checkout</div><div class='code-value'>{{discount_code}}</div></div><br><a href='{{upgrade_link}}' class='btn'>Claim My Discount →</a><div class='expiry'>⏰ Offer expires: {{offer_expiry}}</div></div><div class='features'><div class='feature-row'><span class='feature-icon'>🎨</span>Custom chat themes & exclusive stickers</div><div class='feature-row'><span class='feature-icon'>📹</span>HD photo & video sharing</div><div class='feature-row'><span class='feature-icon'>⭐</span>VibeChat+ badge on your profile</div><div class='feature-row'><span class='feature-icon'>🚫</span>Zero ads, ever</div><div class='feature-row'><span class='feature-icon'>⚡</span>Priority customer support</div></div><div class='footer'><p><a href='#'>Unsubscribe from promotions</a> · <a href='#'>Privacy Policy</a></p><p>© 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hi {{display_name}},\n\nGet {{discount_percent}}% off VibeChat+!\n\nUse code: {{discount_code}}\n\nUpgrade now: {{upgrade_link}}\n\nOffer expires: {{offer_expiry}}\n\n© 2026 Nexa-Group\n\nUnsubscribe: [link]"
    },
    {
      "slug": "win-back",
      "name": "We Miss You! Win-Back",
      "category": "marketing",
      "is_system": false,
      "preview_text": "Your friends are waiting for you on VibeChat! Come back 👋",
      "subject": "{{display_name}}, your friends miss you on VibeChat 👋",
      "variables": ["display_name", "days_inactive", "friend_count", "missed_stories", "reopen_link"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>We Miss You</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.hero{background:linear-gradient(135deg,#12121A,#1A1A24);border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:40px 30px;text-align:center;margin:20px 0}.emoji{font-size:64px;margin-bottom:16px}.title{color:#F8FAFC;font-size:26px;font-weight:800;margin:0 0 12px}.subtitle{color:#94A3B8;font-size:15px;line-height:1.6;margin:0 0 28px}.stats-row{display:flex;justify-content:center;gap:16px;margin-bottom:28px}.stat{background:#1A1A24;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:16px 24px}.stat-value{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.stat-label{color:#64748B;font-size:12px;margin-top:4px}.btn{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:16px 40px;border-radius:50px;font-weight:800;font-size:17px}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}.footer a{color:#8B5CF6;text-decoration:none}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='hero'><div class='emoji'>👋</div><div class='title'>We Miss You, {{display_name}}!</div><div class='subtitle'>It's been {{days_inactive}} days since you last opened VibeChat. Here's what you missed while you were gone:</div><div class='stats-row'><div class='stat'><div class='stat-value'>{{friend_count}}</div><div class='stat-label'>friends active</div></div><div class='stat'><div class='stat-value'>{{missed_stories}}</div><div class='stat-label'>stories posted</div></div></div><a href='{{reopen_link}}' class='btn'>Jump Back In →</a></div><div class='footer'><p><a href='#'>Unsubscribe from all emails</a> · © 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hi {{display_name}},\n\nIt's been {{days_inactive}} days! Your {{friend_count}} friends have been active and {{missed_stories}} stories were posted while you were away.\n\nCome back: {{reopen_link}}\n\n© 2026 Nexa-Group\n\nUnsubscribe: [link]"
    },
    {
      "slug": "app-update",
      "name": "App Update Available",
      "category": "notification",
      "is_system": true,
      "preview_text": "VibeChat has a shiny new update — here's what's new!",
      "subject": "🆕 VibeChat {{version_number}} is here — see what's new!",
      "variables": ["display_name", "version_number", "release_notes", "update_link_ios", "update_link_android"],
      "html_body": "<!DOCTYPE html><html><head><meta charset='utf-8'><title>App Update</title><style>body{margin:0;padding:0;background:#0A0A0F;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif}*{box-sizing:border-box}.container{max-width:600px;margin:0 auto;padding:0 20px}.header{text-align:center;padding:40px 0 20px}.logo{font-size:28px;font-weight:800;background:linear-gradient(135deg,#8B5CF6,#EC4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent}.box{background:#12121A;border:1px solid rgba(255,255,255,0.08);border-radius:20px;padding:40px 30px;margin:20px 0}.version-badge{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;padding:8px 20px;border-radius:50px;font-size:14px;font-weight:700;margin-bottom:20px}.title{color:#F8FAFC;font-size:24px;font-weight:800;margin:0 0 20px}.notes{background:#1A1A24;border-radius:12px;padding:20px;color:#94A3B8;font-size:14px;line-height:1.8;white-space:pre-line;margin-bottom:24px}.btn-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}.btn{display:inline-block;background:linear-gradient(135deg,#8B5CF6,#EC4899);color:#fff;text-decoration:none;padding:12px 28px;border-radius:50px;font-weight:700;font-size:15px}.footer{text-align:center;padding:30px 0;color:#64748B;font-size:12px}.footer a{color:#8B5CF6;text-decoration:none}</style></head><body><div class='container'><div class='header'><div class='logo'>VibeChat</div></div><div class='box'><div style='text-align:center'><span class='version-badge'>Version {{version_number}}</span><div class='title'>What's New in VibeChat 🚀</div></div><div class='notes'>{{release_notes}}</div><div class='btn-row'><a href='{{update_link_ios}}' class='btn'>Update on iOS</a><a href='{{update_link_android}}' class='btn'>Update on Android</a></div></div><div class='footer'><p><a href='#'>Unsubscribe</a> · © 2026 Nexa-Group</p></div></div></body></html>",
      "text_body": "Hi {{display_name}},\n\nVibeChat {{version_number}} is now available!\n\nWhat's new:\n{{release_notes}}\n\nUpdate on iOS: {{update_link_ios}}\nUpdate on Android: {{update_link_android}}\n\n© 2026 Nexa-Group"
    },
    {
      "slug": "streak-achievement",
      "name": "Streak Achievement",
      "category": "notification",
